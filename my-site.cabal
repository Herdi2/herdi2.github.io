name:               my-site
version:            0.1.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          Site.hs
  hs-source-dirs:   src
  build-depends:    base == 4.*
                  , hakyll == 4.16.*
                  , blaze-html == 0.9.*
                  , blaze-markup == 0.8.*
                  , aeson == 2.2.*
                  , text == 2.1.*
                  , pandoc == 3.7.*
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
